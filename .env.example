# Core Authentication
SPEECHMATICS_API_KEY=your_speechmatics_api_key_here

# Subsystem API Endpoint Routing URLs
SPEECHMATICS_BATCH_URL=https://speechmatics.com
SPEECHMATICS_RT_URL=wss://://speechmatics.com
SPEECHMATICS_FLOW_URL=https://speechmatics.com
SPEECHMATICS_TTS_URL=https://speechmatics.com
SM_MANAGEMENT_PLATFORM_URL=https://speechmatics.com

# Local Model Weights & Test Asset Tracking Paths
SILERO_MODEL_PATH=models/silero_vad.onnx
SMART_TURN_MODEL_PATH=models/smart_turn.pt
AUDIO_FILE_PATH=assets/test_audio.wav

# System Run Telemetry & Environment Flags
LOG_LEVEL=INFO
ENVIRONMENT=production
TRANSFORMERS_NO_ADVISORY_WARNINGS=1
